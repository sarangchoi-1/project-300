# Copy to .env and fill in real values. .env is git-ignored - never commit it.
# Nothing in this file has a real value checked in.

# ------------------------------------------------------------------------------
# Flutter app (safe to ship in the client bundle)
# ------------------------------------------------------------------------------
# Both of these are public by design. They only work in combination with RLS,
# which is why every table in back/supabase/migrations has RLS enabled.
SUPABASE_URL=
# Legacy name is SUPABASE_ANON_KEY; newer projects issue an "sb_publishable_..."
# key instead. Use whichever your project shows and keep the name consistent
# across the Flutter code and CI.
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# Developer / CI tooling ONLY - must never be referenced from Flutter code
# ------------------------------------------------------------------------------
# Project ref from the Supabase dashboard URL, e.g. abcdefghijklmnopqrst
SUPABASE_PROJECT_REF=
# Personal access token for the Supabase CLI (`supabase login` stores this for
# you; only set it in CI).
SUPABASE_ACCESS_TOKEN=
# Database password, used by `supabase db push` / `supabase link`.
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------------------------
# SECRET - server-side only, bypasses RLS entirely
# ------------------------------------------------------------------------------
# Required only if the team later adds an Edge Function that needs admin rights.
# NEVER put this in the Flutter app, in a migration, in documentation, or in any
# committed file. Anyone holding it can read and write every table.
SUPABASE_SERVICE_ROLE_KEY=
